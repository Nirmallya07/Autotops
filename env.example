# Claude API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Prometheus (local docker-compose default)
PROMETHEUS_URL=http://localhost:9090

# Kubernetes — leave blank to use default ~/.kube/config context
KUBE_CONTEXT=kind-autoops
KUBE_NAMESPACE=autoops

# Notifications (optional, wire up later)
SLACK_WEBHOOK_URL=

# Agent behavior
# Below this Claude-reported confidence (0-1), the agent notifies a human
# instead of acting on its own.
AUTO_REMEDIATE_CONFIDENCE_THRESHOLD=0.75
